# ==============================================================================
# Sanwaliya Printing Press - Environment Configuration (.env.example)
# Copy this file to .env.local and fill in your actual credentials.
# Do NOT commit .env.local to version control!
# ==============================================================================

# Database: MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/sanwaliya?retryWrites=true&w=majority

# Authentication: Bcrypt hash of the master admin password (generate with: npm run hash-password)
ADMIN_PASSWORD_HASH=$2a$10$YourGeneratedBcryptHashGoesHere

# Authentication: Secure JWT signing secret (at least 32 characters long)
SESSION_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public Contact Details
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210
NEXT_PUBLIC_PHONE_NUMBER=+91 98765 43210

# Cloudinary Image Hosting (Used in Stage 4)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Optional: Upstash Redis for distributed rate-limiting (Fallback to MongoDB TTL limiter if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
